# syntax=docker/dockerfile:1.5


####################################
# Composer binary
####################################

FROM composer:2.10.3 AS composer-bin

FROM node:24.22.1-bookworm-slim AS node-runtime

COPY scripts/install-patched-npm-undici.sh /usr/local/bin/install-patched-npm-undici
RUN npm install --global npm@12.2.1 \
    && sh /usr/local/bin/install-patched-npm-undici \
    && test "$(node --version)" = "v24.22.1" \
    && test "$(npm --version)" = "12.2.1" \
    && test "$(node -p 'require("/usr/local/lib/node_modules/npm/node_modules/undici/package.json").version')" = "6.29.1"

FROM php:8.4.27-cli AS libxml2-build

COPY docker/libxml2/CVE-2026-86140.patch /tmp/CVE-2026-86140.patch
COPY docker/libxml2/verify-bounded-dtd-error.php /usr/local/libexec/verify-bounded-dtd-error.php
COPY docker/libxml2/build-fixed-package.sh /usr/local/bin/build-fixed-libxml2
RUN /usr/local/bin/build-fixed-libxml2



####################################
# PHP dependencies + Node build
####################################

FROM php:8.4.27-cli AS build

WORKDIR /var/www/html

COPY --from=node-runtime /usr/local/ /usr/local/


RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    curl \
    libzip-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libonig-dev \
    && docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        mbstring \
        gd \
        zip \
        pdo \
        pdo_mysql \
        bcmath \
    && rm -rf /var/lib/apt/lists/*


COPY --from=composer-bin /usr/bin/composer /usr/local/bin/composer


####################################
# Install PHP dependencies
####################################

COPY composer.json composer.lock ./


RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts



####################################
# Install frontend dependencies
####################################

COPY package.json package-lock.json ./
COPY scripts/verify-npm-lock-sources.mjs ./scripts/


RUN node scripts/verify-npm-lock-sources.mjs package-lock.json \
    && npm ci --allow-remote=all \
    --no-audit \
    --no-fund



####################################
# Copy application
####################################

COPY . .



####################################
# Laravel + Vite production build
####################################

RUN rm -f public/hot public/build/hot


# Wayfinder needs PHP + vendor
RUN php artisan wayfinder:generate --with-form


RUN npm run build


RUN rm -f public/hot public/build/hot





####################################
# Production runtime
####################################

FROM php:8.4.27-apache AS final


WORKDIR /var/www/html

COPY --from=libxml2-build /tmp/libxml2-fixed.deb /opt/libxml2-fixed.deb
COPY docker/libxml2/verify-bounded-dtd-error.php /usr/local/libexec/verify-bounded-dtd-error.php


ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr


####################################
# PHP extensions
####################################

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libzip-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libonig-dev \
    && docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        mbstring \
        gd \
        zip \
        pdo \
        pdo_mysql \
        bcmath \
        opcache \
    && a2enmod \
        rewrite \
        headers \
        expires \
        deflate \
    && apt-get purge -y \
        libzip-dev \
        libpng-dev \
        libjpeg62-turbo-dev \
        libfreetype6-dev \
        libonig-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN dpkg -i /opt/libxml2-fixed.deb \
    && rm /opt/libxml2-fixed.deb \
    && ldconfig \
    && dpkg-query -W -f='${Package} ${Version}\n' libxml2 \
    && php /usr/local/libexec/verify-bounded-dtd-error.php



####################################
# PHP production settings
####################################

RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"


RUN { \
    echo "expose_php=Off"; \
    echo "memory_limit=256M"; \
    echo "upload_max_filesize=32M"; \
    echo "post_max_size=32M"; \
    echo "max_execution_time=120"; \
} > /usr/local/etc/php/conf.d/production.ini



RUN { \
    echo "opcache.enable=1"; \
    echo "opcache.memory_consumption=128"; \
    echo "opcache.interned_strings_buffer=8"; \
    echo "opcache.max_accelerated_files=20000"; \
    echo "opcache.validate_timestamps=0"; \
} > /usr/local/etc/php/conf.d/opcache.ini



####################################
# Apache configuration
####################################

RUN sed -ri \
    -e 's!/var/www/html!/var/www/html/public!g' \
    /etc/apache2/sites-available/*.conf


RUN a2enmod rewrite



####################################
# Copy Laravel application
####################################

COPY . .


COPY --from=build \
    /var/www/html/vendor \
    ./vendor


COPY --from=build \
    /var/www/html/public/build \
    ./public/build



####################################
# Laravel permissions
####################################

RUN mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data \
        storage \
        bootstrap/cache \
        public/build



####################################
# Remove development files
####################################

RUN rm -f public/hot public/build/hot



####################################
# Healthcheck
####################################

HEALTHCHECK \
    --interval=30s \
    --timeout=10s \
    --start-period=60s \
    --retries=5 \
    CMD curl -fsS http://127.0.0.1/up >/dev/null || exit 1



EXPOSE 80


CMD ["apache2-foreground"]
