{
    "compilerOptions": {
        /* Visit https://aka.ms/tsconfig to read more about this file */

        /* Projects */
        // "incremental": true,                              /* Save .tsbuildinfo files to allow for incremental compilation of projects. */
        // "composite": true,                                /* Enable constraints that allow a TypeScript project to be used with project references. */
        // "tsBuildInfoFile": "./.tsbuildinfo",              /* Specify the path to .tsbuildinfo incremental compilation file. */
        // "disableSourceOfProjectReferenceRedirect": true,  /* Disable preferring source files instead of declaration files when referencing composite projects. */
        // "disableSolutionSearching": true,                 /* Opt a project out of multi-project reference checking. */
        // "disableReferencedProjectLoad": true,             /* Reduce the number of projects loaded automatically by TypeScript. */

        /* Language and Environment */
        "target": "ESNext" /* Set the JavaScript language version for emitted JavaScript. */,
        "useDefineForClassFields": true,
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ] /* Specify bundled library files that describe the target runtime environment. */,
        "jsx": "preserve" /* Specify what JSX code is generated. */,
        "jsxImportSource": "vue" /* Specify JSX factory import source. */,

        /* Modules */
        "module": "ESNext" /* Specify what module code is generated. */,
        "moduleResolution": "bundler" /* Specify how TypeScript looks up module specifiers. */,
        "paths": {
            "@/*": ["./resources/js/*"]
        },
        "types": ["vite/client"],
        "resolveJsonModule": true /* Enable importing .json files. */,

        /* JavaScript Support */
        "allowJs": true /* Allow JavaScript files to be part of the program. */,

        /* Emit */
        "sourceMap": true /* Create source map files. */,
        "noEmit": true /* Disable emitting files from compilation. */,

        /* Interop Constraints */
        "isolatedModules": true /* Ensure each file can be safely transpiled. */,
        "esModuleInterop": true /* Ease CommonJS interop. */,
        "forceConsistentCasingInFileNames": true /* Ensure casing is correct in imports. */,

        /* Type Checking */
        "strict": true /* Enable all strict type-checking options. */,

        /* Completeness */
        "skipLibCheck": true /* Skip type checking all .d.ts files. */
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.vue"
    ]
}
