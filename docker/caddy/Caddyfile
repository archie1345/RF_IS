{
    email {$ACME_EMAIL}
    admin off
}

{$APP_DOMAIN} {
    encode zstd gzip

    reverse_proxy server:80

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
    }

    log {
        output stdout
        format console
    }
}
