COMPOSE_PROJECT_NAME=rf-is
APP_IMAGE=rf-is:production
APP_ENV_FILE=.env.production

APP_DOMAIN=rf.example.id
ACME_EMAIL=admin@example.id

APP_NAME="RF Information System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rf.example.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=rf_is
DB_USERNAME=rf_user
DB_PASSWORD=replace_with_a_long_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_root_password
MYSQL_VERSION=8.4

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.id
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-3
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

APP_CONTAINER_NAME=rf-server
WORKER_CONTAINER_NAME=rf-worker
SCHEDULER_CONTAINER_NAME=rf-scheduler
MIGRATE_CONTAINER_NAME=rf-migrate
DB_CONTAINER_NAME=rf-db
CADDY_CONTAINER_NAME=rf-caddy

DB_VOLUME_NAME=rf_is_prod_db-data
APP_STORAGE_VOLUME_NAME=rf_is_prod_app-storage
CADDY_DATA_VOLUME_NAME=rf_is_prod_caddy-data
CADDY_CONFIG_VOLUME_NAME=rf_is_prod_caddy-config
