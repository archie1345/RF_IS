APP_NAME="RF Information System"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.vercel.app
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Vercel reverse proxy & CORS
TRUSTED_PROXIES=*
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOWED_ORIGIN_PATTERNS=^https://.*\.vercel\.app$
SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app

# External Managed Database (e.g. Aiven, TiDB Cloud, PlanetScale, RDS, Supabase/Neon)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=rf_is
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=

# Stateless / serverless-friendly defaults
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=array
QUEUE_CONNECTION=sync

# Note: Local disk on Vercel (/tmp/storage) is ephemeral per function instance.
# Configure S3-compatible storage (S3, Cloudflare R2, etc.) for persistent uploads.
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.id
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-3
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
